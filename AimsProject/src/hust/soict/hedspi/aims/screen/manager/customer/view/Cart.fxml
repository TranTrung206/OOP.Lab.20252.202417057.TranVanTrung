<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="768.0" prefWidth="1024.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hust.soict.hedspi.aims.screen.manager.customer.controller.CartController">

    <top>
        <HBox alignment="CENTER" prefHeight="100.0">
            <padding>
                <Insets left="20" right="20"/>
            </padding>

            <children>

                <Label text="CART" textFill="#004cff">
                    <font>
                        <Font size="50"/>
                    </font>
                </Label>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="View Store"
                        prefWidth="100"
                        prefHeight="50"
                        onAction="#btnViewStorePressed"/>
            </children>
        </HBox>
    </top>

    <center>

        <VBox alignment="CENTER">

            <padding>
                <Insets left="20" right="20"/>
            </padding>

            <children>

                <HBox alignment="CENTER_LEFT" spacing="10">

                    <padding>
                        <Insets top="10" bottom="10"/>
                    </padding>

                    <children>

                        <Label text="Filter"/>

                        <TextField fx:id="tfFilter"/>

                        <RadioButton fx:id="radioBtnFilterId"
                                     selected="true"
                                     text="By ID"/>

                        <RadioButton fx:id="radioBtnFilterTitle"
                                     text="By Title"/>

                    </children>

                </HBox>

                <TableView fx:id="tblMedia">

                    <columns>

                        <TableColumn fx:id="colId"
                                     text="ID"/>

                        <TableColumn fx:id="colTitle"
                                     text="Title"/>

                        <TableColumn fx:id="colCategory"
                                     text="Category"/>

                        <TableColumn fx:id="colCost"
                                     text="Cost"/>

                    </columns>

                </TableView>

                <HBox alignment="TOP_RIGHT"
                      spacing="20">

                    <padding>
                        <Insets top="10"/>
                    </padding>

                    <children>

                        <Button fx:id="btnPlay"
                                text="Play"
                                prefWidth="60"
                                onAction="#btnPlayPressed"/>

                        <Button fx:id="btnRemove"
                                text="Remove"
                                prefWidth="60"
                                onAction="#btnRemovePressed"/>

                    </children>

                </HBox>

            </children>

        </VBox>

    </center>

    <bottom>

        <VBox alignment="TOP_CENTER"
              spacing="30"
              prefHeight="200">

            <children>

                <HBox alignment="CENTER"
                      spacing="10">

                    <children>

                        <Label text="Total:">
                            <font>
                                <Font size="24"/>
                            </font>
                        </Label>

                        <Label fx:id="lblTotalCost"
                               text="0 $">
                            <font>
                                <Font size="24"/>
                            </font>
                        </Label>

                    </children>

                </HBox>

                <Button text="Place Order"
                        onAction="#btnPlaceOrderPressed"
                        style="-fx-background-color: #004cff; -fx-text-fill: white;">
                    <font>
                        <Font size="24"/>
                    </font>
                </Button>

            </children>

        </VBox>

    </bottom>

</BorderPane>